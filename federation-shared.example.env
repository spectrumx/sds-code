# Shared by gateway + federation sync (repo root; gateway/scripts/generate-secrets.sh).
# Compose: env_file → ../../federation-shared.env (gateway) or ../federation-shared.env (federation).
# FEDERATION_SYNC_DRF_TOKEN: DRF Token for GET /users/get-federation-sync-api-key/ (required).
# FEDERATION_SYNC_SERVER_API_KEY: optional export Api-Key override. When empty, the sync
# service mints one at startup via the DRF token and caches it in-process.

FEDERATION_SYNC_DRF_TOKEN=
FEDERATION_SYNC_SERVER_API_KEY=
