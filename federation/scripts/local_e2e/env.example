# Copy to federation/scripts/local_e2e/.env (never commit secrets).

# Optional: remote SDS host for SDK imports (no default — set explicitly)
# SDS_HOST=
# SDS_SECRET_TOKEN=
# DATASET_UUID=
# TOP_LEVEL_DIR=

# Local gateway (publish / upload target)
LOCAL_SDS_HOST=localhost:8000
LOCAL_SDS_SECRET_TOKEN=

# Federation sync live checks
FEDERATION_GATEWAY_API_KEY=
FEDERATION_SYNC_URL=http://localhost:8001
LOCAL_SITE_FQDN=sds.localhost
