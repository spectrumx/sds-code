# Copy to federation/scripts/local_e2e/.env (never commit secrets).
# CRC download (production read-only):
SDS_HOST=sds.crc.nd.edu
SDS_SECRET_TOKEN=

# Optional: filter download to one capture directory (from list_dataset_captures)
# DATASET_UUID=
# TOP_LEVEL_DIR=/files/you@example.com/federation-fixture/...

# Local gateway upload (after download):
LOCAL_SDS_HOST=localhost:8000
LOCAL_SDS_SECRET_TOKEN=

# Federation sync (gateway export for bootstrap):
FEDERATION_GATEWAY_API_KEY=

# Live checks
FEDERATION_SYNC_URL=http://localhost:8001
LOCAL_SITE_FQDN=localhost
