# Optional overrides for compose.local.yaml (flagship lab sync on :8001).
# Copy to .env.local (gitignored) and pass: docker compose -f compose.local.yaml --env-file .env.local up -d
#
# Applicant challenge when THIS host's sync serves /.well-known/sds-federation.json
# (unusual on flagship lab — default local verify uses gateway django.env instead).
# FEDERATION_REGISTRY_CHALLENGE_TOKEN=
#
# Well-known registry metadata when sync serves signed manifest (flagship lab with [registry.publish]):
# FEDERATION_REGISTRY_WELL_KNOWN_URL=http://sds.localhost/.well-known/sds-registry
# FEDERATION_REGISTRY_PUBKEY_FINGERPRINT=sha256:...
