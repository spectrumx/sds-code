# Optional env for compose.peer.remote.yaml (copy to .env.peer; do not commit secrets).

PEER_SITE_NAME=peer
PEER_SYNC_PORT=8000
PEER_OPENSEARCH_PORT=9200
PEER_REDIS_PORT=6379

# Public URL other sites use in their federation.toml [[peers]].sync_service_url
PEER_SYNC_PUBLIC_URL=https://peer.example.com/sync

FEDERATION_BOOTSTRAP_ON_START=true
