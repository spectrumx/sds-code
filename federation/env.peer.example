# Optional env for compose.peer.remote.yaml / compose.peer.local.yaml
# Copy to .env.peer in this directory (gitignored). Do not commit secrets.
#
#   cp env.peer.example .env.peer
#   docker compose -f compose.peer.remote.yaml --env-file .env.peer up -d --build
#
# Do not use federation/peer.env — compose reads .env.peer only.

PEER_SITE_NAME=fed1
PEER_OPENSEARCH_PORT=9200

# Public URL the mothership puts in federation.toml [[peers]].sync_service_url
PEER_SYNC_PUBLIC_URL=https://sds-fed1.crc.nd.edu/sync

FEDERATION_BOOTSTRAP_ON_START=true

# Applicant registry verify: paste the ONE-TIME raw token from the mothership application UI
# (mothership stores sha256 in DB). Sync serves it as registry_challenge in
# GET /.well-known/sds-federation.json when Traefik routes that path to this container.
# Recreate sync after changing: docker compose ... up -d --force-recreate sds-federation-peer-sync
FEDERATION_REGISTRY_CHALLENGE_TOKEN=
