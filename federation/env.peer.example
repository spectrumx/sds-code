# Optional env for compose.peer.remote.yaml (copy to .env.peer; do not commit secrets).

PEER_SITE_NAME=fed1
PEER_OPENSEARCH_PORT=9200

# Public URL sds-dev puts in federation.toml [[peers]].sync_service_url
# Peers use Traefik :443 PathPrefix(/sync) — not a host-published sync port.
PEER_SYNC_PUBLIC_URL=https://sds-fed1.crc.nd.edu/sync

FEDERATION_BOOTSTRAP_ON_START=true
