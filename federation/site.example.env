SDS_SITE_NAME="your-site"
SDS_SITE_FQDN="your-site.example.edu"
SDS_SITE_DISPLAY_NAME="Your Site"
FEDERATION_SYNC_SERVICE_URL="https://your-site.example.edu/sync"
GATEWAY_INTERNAL_BASE_URL="http://sds-gateway-prod-app:18000/api/v1"
REDIS_URL="redis://sds-gateway-prod-redis:6379/0"
# Optional PEM under federation/certs/ for bootstrap peer TLS
FEDERATION_PEER_CA_PATH=""
# Flagship registry signing on sync only (peers: false)
FEDERATION_REGISTRY_PUBLISH_ENABLED="false"
# Poll signed manifest from mothership (rendered into federation.toml [registry])
FEDERATION_REGISTRY_CONSUMER_ENABLED="true"
FEDERATION_REGISTRY_URL="https://sds.crc.nd.edu/.well-known/sds-registry"
FEDERATION_REGISTRY_PUBKEY_PATH="/etc/sds/certs/sds-registry.pub.pem"
FEDERATION_REGISTRY_REFRESH_SECS="900"
# Peer: just federation-fetch-registry-pubkey (or auto during federation-render-config)
# Optional OOB pin from operators:
# FEDERATION_REGISTRY_PUBKEY_FINGERPRINT=sha256:...
FEDERATION_REGISTRY_WELL_KNOWN_URL="https://sds.crc.nd.edu/.well-known/sds-registry"