SDS_SITE_NAME="your-site"
SDS_SITE_FQDN="your-site.example.edu"
SDS_SITE_DISPLAY_NAME="Your Site"
FEDERATION_SYNC_SERVICE_URL="https://your-site.example.edu/sync"
GATEWAY_INTERNAL_BASE_URL="http://sds-gateway-prod-app:18000/api/v1"
REDIS_URL="redis://sds-gateway-prod-redis:6379/0"
# Optional PEM under federation/certs/ for bootstrap peer TLS
FEDERATION_PEER_CA_PATH=""
# Flagship registry signing on sync (omit or false for peer-only hosts)
FEDERATION_REGISTRY_PUBLISH_ENABLED="true"
# Sync env (compose site.env / optional .env.local): well-known registry metadata
# FEDERATION_REGISTRY_WELL_KNOWN_URL=https://sds.crc.nd.edu/.well-known/sds-registry
# FEDERATION_REGISTRY_PUBKEY_FINGERPRINT=sha256:...
